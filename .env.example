# ---------------------------------------------------------------------------
# Base de données PostgreSQL
# Ces variables sont consommées par l'image postgres ET par le backend.
# ---------------------------------------------------------------------------
POSTGRES_USER=taskforge
POSTGRES_PASSWORD=change_me_in_your_local_env
POSTGRES_DB=taskforge

# Nom du service docker-compose, PAS localhost :
# depuis un conteneur, localhost désigne le conteneur lui-même.
DB_HOST=postgres
DB_PORT=5432

# Port exposé sur la machine hôte (utile pour un client SQL externe)
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# Backend (NestJS)
# ---------------------------------------------------------------------------
NODE_ENV=development
BACKEND_PORT=3000

# Niveau de log pino : fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Authentification
# Générer une vraie valeur avec :  openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=remplace_moi_par_une_valeur_generee_aleatoirement
JWT_EXPIRES_IN=1h

# ---------------------------------------------------------------------------
# Frontend (Vue 3 + Vite)
# Seules les variables préfixées VITE_ sont exposées au navigateur.
# Ne jamais y placer de secret : elles finissent dans le bundle public.
# ---------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000